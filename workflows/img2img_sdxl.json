{
  "3": {
    "inputs": {
      "seed": {{seed}},
      "steps": 40,
      "cfg": 8,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": "{{denoise}}",
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["11", 0]
    },
    "class_type": "KSampler"
  },
  "4": {
    "inputs": {
      "ckpt_name": "{{model}}"
    },
    "class_type": "CheckpointLoaderSimple"
  },
  "6": {
    "inputs": {
      "text": "{{prompt}}, space, cosmic, nebula, stars, JWST, detailed, high quality, 8k",
      "clip": ["4", 1]
    },
    "class_type": "CLIPTextEncode"
  },
  "7": {
    "inputs": {
      "text": "blurry, soft focus, out of focus, bokeh, low quality, low resolution, pixelated, jpeg artifacts, compression artifacts, noise, grainy, watermark, text, signature, ugly, deformed",
      "clip": ["4", 1]
    },
    "class_type": "CLIPTextEncode"
  },
  "8": {
    "inputs": {
      "samples": ["3", 0],
      "vae": ["13", 0]
    },
    "class_type": "VAEDecode"
  },
  "9": {
    "inputs": {
      "filename_prefix": "jwst_generated",
      "images": ["8", 0]
    },
    "class_type": "SaveImage"
  },
  "10": {
    "inputs": {
      "image": "{{image}}",
      "upload": "image"
    },
    "class_type": "LoadImage"
  },
  "11": {
    "inputs": {
      "pixels": ["12", 0],
      "vae": ["13", 0]
    },
    "class_type": "VAEEncode"
  },
  "12": {
    "inputs": {
      "upscale_method": "lanczos",
      "width": "{{width}}",
      "height": "{{height}}",
      "crop": "center",
      "image": ["10", 0]
    },
    "class_type": "ImageScale"
  },
  "13": {
    "inputs": {
      "vae_name": "sdxl_vae.safetensors"
    },
    "class_type": "VAELoader"
  }
}
